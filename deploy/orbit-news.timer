[Unit]
Description=Refresh Orbit news radar daily

[Timer]
# Run once per day at 06:00 UTC. Persistent=true means a missed run (e.g. VM was
# off or rebooting) fires as soon as the timer is active again.
OnCalendar=*-*-* 06:00:00
Persistent=true
RandomizedDelaySec=120
Unit=orbit-news.service

[Install]
WantedBy=timers.target
