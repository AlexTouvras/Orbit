# local env files
.env
.env*.local

# generated news cache (refreshed by .github/workflows/news-refresh.yml)
# /data/news-cache.json is tracked so Vercel builds include fresh signals.

# Local weekly Write draft / IDE brief (CI force-adds draft when notifying Slack)
/data/weekly-write-draft.json
/data/weekly-write-ide-brief.json
/data/weekly-write-ide-brief.md
/data/weekly-write.log

# Raw GeoJSON used only to rebuild eu-zone-paths.ts
/data/live/geo-raw/

# Local newsletter digest draft (GitHub API persist for send status)
/data/newsletter-draft.json

# Studio-saved profile (tracked for Vercel; updated via Studio → GitHub)
# /data/profile.json

# Studio-saved published projects
# /data/published-projects.json

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.vscode/*
!.vscode/extensions.json
.idea
.env*

# Agent local working memory (ARCHITECTURE/BACKLOG stay tracked)
.state/CURRENT_TASK.md
.state/LESSONS.md

# Cursor canvases are IDE-only (`cursor/canvas`); Next typecheck cannot resolve them
/canvases/
