diff --git a/scripts/practice-sources.mjs b/scripts/practice-sources.mjs
new file mode 100644
index 0000000..d4eeff5
--- /dev/null
+++ b/scripts/practice-sources.mjs
@@ -0,0 +1,351 @@
+/**
+ * Practice discovery for the agentic field card: engineering writing and
+ * web searches, separate from the GitHub framework search.
+ *
+ * A hit can earn a decision-table row or an anti-pattern. It cannot earn
+ * a picker row. URLs already listed in data/practice-seen.json stay quiet.
+ */
+
+const MONTHS = {
+  jan: 0,
+  feb: 1,
+  mar: 2,
+  apr: 3,
+  may: 4,
+  jun: 5,
+  jul: 6,
+  aug: 7,
+  sep: 8,
+  oct: 9,
+  nov: 10,
+  dec: 11,
+};
+
+export const READING_CAP = 8;
+export const SEARCH_PER_QUERY = 2;
+export const SEARCH_CAP = 8;
+
+import https from "node:https";
+
+const UA = "Mozilla/5.0 (compatible; agentic-ai-field-card-discover/1.0)";
+
+export function decodeEntities(value) {
+  return String(value || "")
+    .replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, "$1")
+    .replace(/&amp;/g, "&")
+    .replace(/&lt;/g, "<")
+    .replace(/&gt;/g, ">")
+    .replace(/&quot;/g, '"')
+    .replace(/&#39;/g, "'")
+    .replace(/&apos;/g, "'")
+    .replace(/&#(\d+);/g, (_, n) => String.fromCodePoint(Number(n)))
+    .replace(/&#x([0-9a-f]+);/gi, (_, n) => String.fromCodePoint(parseInt(n, 16)));
+}
+
+export function stripTags(value) {
+  return decodeEntities(value)
+    .replace(/<[^>]+>/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+export function normalizeUrl(url) {
+  try {
+    const u = new URL(String(url).trim());
+    u.hash = "";
+    for (const key of [...u.searchParams.keys()]) {
+      if (key.toLowerCase().startsWith("utm_") || key === "ref" || key === "source") {
+        u.searchParams.delete(key);
+      }
+    }
+    let out = u.toString();
+    if (out.endsWith("/")) out = out.slice(0, -1);
+    return out;
+  } catch {
+    return String(url || "").trim();
+  }
+}
+
+export function hostOf(url) {
+  try {
+    return new URL(url).hostname.toLowerCase().replace(/^www\./, "");
+  } catch {
+    return "";
+  }
+}
+
+export function parseLooseDate(value) {
+  if (!value) return null;
+  const text = String(value).trim();
+  const iso = text.match(/(\d{4})-(\d{2})-(\d{2})/);
+  if (iso) return Date.UTC(Number(iso[1]), Number(iso[2]) - 1, Number(iso[3]));
+  const dmy = text.match(/(\d{1,2})\s+([A-Za-z]{3,9})\s+(\d{4})/);
+  if (dmy) {
+    const month = MONTHS[dmy[2].slice(0, 3).toLowerCase()];
+    if (month == null) return null;
+    return Date.UTC(Number(dmy[3]), month, Number(dmy[1]));
+  }
+  const parsed = Date.parse(text);
+  return Number.isNaN(parsed) ? null : parsed;
+}
+
+/** Card stamp `Reviewed 4 Sep 2026`, else 40 days before now. */
+export function reviewCutoffMs(html, now = Date.now()) {
+  const match = String(html || "").match(/Reviewed\s+(\d{1,2}\s+[A-Za-z]{3,9}\s+\d{4})/i);
+  if (match) {
+    const ms = parseLooseDate(match[1]);
+    if (ms != null) return ms;
+  }
+  return now - 40 * 86400000;
+}
+
+function tagText(block, tag) {
+  const match = block.match(new RegExp(`<${tag}\\b[^>]*>([\\s\\S]*?)</${tag}>`, "i"));
+  return match ? match[1] : "";
+}
+
+function atomLink(block) {
+  const links = [...block.matchAll(/<link\b([^>]*)\/?>/gi)];
+  let fallback = "";
+  for (const link of links) {
+    const attrs = link[1];
+    const href = attrs.match(/\bhref="([^"]+)"/i);
+    if (!href) continue;
+    const rel = attrs.match(/\brel="([^"]+)"/i);
+    if (rel && /\balternate\b/i.test(rel[1])) return href[1];
+    if (!rel && !fallback) fallback = href[1];
+  }
+  return fallback;
+}
+
+export function parseRssOrAtom(xml) {
+  const items = [];
+  for (const match of String(xml || "").matchAll(/<item\b[^>]*>([\s\S]*?)<\/item>/gi)) {
+    const block = match[1];
+    const title = stripTags(tagText(block, "title"));
+    const url = stripTags(tagText(block, "link"));
+    const publishedAt = stripTags(tagText(block, "pubDate") || tagText(block, "dc:date"));
+    const summary = stripTags(tagText(block, "description")).slice(0, 240);
+    if (title && url) items.push({ title, url, publishedAt: publishedAt || null, summary });
+  }
+  if (items.length) return items;
+
+  for (const match of String(xml || "").matchAll(/<entry\b[^>]*>([\s\S]*?)<\/entry>/gi)) {
+    const block = match[1];
+    const title = stripTags(tagText(block, "title"));
+    const url = atomLink(block);
+    const publishedAt = stripTags(tagText(block, "published") || tagText(block, "updated"));
+    const summary = stripTags(tagText(block, "summary") || tagText(block, "content")).slice(0, 240);
+    if (title && url) items.push({ title, url, publishedAt: publishedAt || null, summary });
+  }
+  return items;
+}
+
+export function parseAnthropicEngineering(html) {
+  const items = [];
+  const seen = new Set();
+  const re =
+    /<a\b[^>]*\bhref="(\/engineering\/[^"#?]+)"[^>]*>[\s\S]*?<h3\b[^>]*>([\s\S]*?)<\/h3>[\s\S]*?<time\b[^>]*\bdateTime="(\d{4}-\d{2}-\d{2})"/gi;
+  for (const match of String(html || "").matchAll(re)) {
+    const path = match[1];
+    if (seen.has(path)) continue;
+    seen.add(path);
+    items.push({
+      title: stripTags(match[2]),
+      url: `https://www.anthropic.com${path}`,
+      publishedAt: match[3],
+      summary: "",
+    });
+  }
+  return items;
+}
+
+export function parseDuckDuckGoLite(html) {
+  const items = [];
+  const seen = new Set();
+  const re = /<a\b[^>]*\bhref="(https?:\/\/[^"]+)"[^>]*>([\s\S]*?)<\/a>/gi;
+  for (const match of String(html || "").matchAll(re)) {
+    const url = match[1];
+    if (/duckduckgo\.com/i.test(url)) continue;
+    const title = stripTags(match[2]);
+    if (title.length < 8) continue;
+    const key = normalizeUrl(url);
+    if (seen.has(key)) continue;
+    seen.add(key);
+    items.push({ title, url, publishedAt: null, summary: "" });
+  }
+  return items;
+}
+
+function skipTitle(title, prefixes) {
+  if (!prefixes?.length) return false;
+  const text = title.trim().toLowerCase();
+  return prefixes.some((prefix) => text.startsWith(String(prefix).toLowerCase()));
+}
+
+function matchesTerms(text, terms) {
+  if (!terms?.length) return true;
+  const hay = text.toLowerCase();
+  return terms.some((term) => hay.includes(String(term).toLowerCase()));
+}
+
+function inWindow(item, cutoffMs) {
+  const ms = parseLooseDate(item.publishedAt);
+  if (ms == null) return true;
+  return ms >= cutoffMs - 86400000;
+}
+
+function ignoredHost(url, ignoreHosts) {
+  const host = hostOf(url);
+  if (!host) return true;
+  return ignoreHosts.has(host);
+}
+
+/**
+ * @param {{ readings: object[], searches: {query: string, hits: object[]}[], seenUrls: string[], ignoreHosts: string[], cutoffMs: number }} input
+ */
+export function buildPracticeHits(input) {
+  const seen = new Set((input.seenUrls || []).map(normalizeUrl));
+  const ignore = new Set((input.ignoreHosts || []).map((host) => host.toLowerCase().replace(/^www\./, "")));
+  const hits = [];
+  const used = new Set();
+
+  function push(item, via, source, query) {
+    if (hits.length >= READING_CAP + SEARCH_CAP && via === "search") return false;
+    const url = normalizeUrl(item.url);
+    if (!url || used.has(url) || seen.has(url)) return false;
+    if (ignoredHost(url, ignore)) return false;
+    if (!inWindow(item, input.cutoffMs)) return false;
+    if (via === "reading" && hits.filter((hit) => hit.via === "reading").length >= READING_CAP) return false;
+    if (via === "search" && hits.filter((hit) => hit.via === "search").length >= SEARCH_CAP) return false;
+    used.add(url);
+    hits.push({
+      title: item.title,
+      url,
+      publishedAt: item.publishedAt || null,
+      summary: item.summary || "",
+      via,
+      source: source || null,
+      query: query || null,
+    });
+    return true;
+  }
+
+  for (const item of input.readings || []) push(item, "reading", item.source, null);
+  for (const group of input.searches || []) {
+    let kept = 0;
+    for (const item of group.hits || []) {
+      if (kept >= SEARCH_PER_QUERY) break;
+      if (push(item, "search", null, group.query)) kept += 1;
+    }
+  }
+  return hits;
+}
+
+async function getText(url, fetchImpl) {
+  const res = await fetchImpl(url, {
+    headers: { "User-Agent": UA, Accept: "text/html,application/xml,application/atom+xml,*/*" },
+    redirect: "follow",
+  });
+  if (!res.ok) throw new Error(`${res.status} ${url}`);
+  return res.text();
+}
+
+function postDuckDuckGo(query) {
+  const body = new URLSearchParams({ q: query }).toString();
+  return new Promise((resolve, reject) => {
+    const req = https.request(
+      {
+        hostname: "lite.duckduckgo.com",
+        path: "/lite/",
+        method: "POST",
+        headers: {
+          "User-Agent": "Mozilla/5.0",
+          Accept: "text/html",
+          "Content-Type": "application/x-www-form-urlencoded",
+          "Content-Length": Buffer.byteLength(body),
+        },
+      },
+      (res) => {
+        const chunks = [];
+        res.on("data", (chunk) => chunks.push(chunk));
+        res.on("end", () => {
+          const text = Buffer.concat(chunks).toString("utf8");
+          if (res.statusCode < 200 || res.statusCode >= 300) {
+            reject(new Error(`${res.statusCode} web search`));
+            return;
+          }
+          resolve(text);
+        });
+      },
+    );
+    req.on("error", reject);
+    req.write(body);
+    req.end();
+  });
+}
+
+export async function searchWeb(query) {
+  const hits = parseDuckDuckGoLite(await postDuckDuckGo(query));
+  if (!hits.length) throw new Error("web search returned no results");
+  return hits;
+}
+
+export function loadSeenUrls(raw) {
+  const urls = Array.isArray(raw?.urls) ? raw.urls : [];
+  return urls
+    .map((entry) => (typeof entry === "string" ? entry : entry?.url))
+    .filter(Boolean);
+}
+
+export async function collectPractice({ watchlist, html, seenUrls, fetchImpl = globalThis.fetch, now = Date.now() }) {
+  const cutoffMs = reviewCutoffMs(html, now);
+  const readings = [];
+  const searches = [];
+  const errors = [];
+
+  for (const source of watchlist.readings || []) {
+    try {
+      const body = await getText(source.url, fetchImpl);
+      let items =
+        source.parser === "anthropic-engineering" ? parseAnthropicEngineering(body) : parseRssOrAtom(body);
+      items = items.filter((item) => !skipTitle(item.title, source.skipTitlePrefix));
+      items = items.filter((item) => matchesTerms(`${item.title} ${item.summary || ""}`, source.requireAny));
+      items.sort((a, b) => (parseLooseDate(b.publishedAt) || 0) - (parseLooseDate(a.publishedAt) || 0));
+      for (const item of items) readings.push({ ...item, source: source.name });
+    } catch (err) {
+      errors.push({ source: source.name, error: String(err.message || err) });
+    }
+  }
+
+  for (const query of watchlist.practiceQueries || []) {
+    try {
+      const hits = await searchWeb(query);
+      searches.push({ query, error: null, hits });
+    } catch (err) {
+      searches.push({ query, error: String(err.message || err), hits: [] });
+      errors.push({ source: query, error: String(err.message || err) });
+    }
+  }
+
+  const hits = buildPracticeHits({
+    readings,
+    searches,
+    seenUrls,
+    ignoreHosts: watchlist.practiceIgnoreHosts || [],
+    cutoffMs,
+  });
+
+  return {
+    cutoff: new Date(cutoffMs).toISOString().slice(0, 10),
+    readings: readings.length,
+    searchQueries: (watchlist.practiceQueries || []).length,
+    hits,
+    errors,
+    searches: searches.map((group) => ({
+      query: group.query,
+      error: group.error,
+      top: group.hits.slice(0, SEARCH_PER_QUERY).map((hit) => ({ title: hit.title, url: normalizeUrl(hit.url) })),
+    })),
+  };
+}
