+#!/usr/bin/env node
+/**
+ * Fail when this run's practice hits are not recorded in data/practice-seen.json.
+ * The monthly agent runs this after judging, including on a no-change decision.
+ */
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { loadSeenUrls, normalizeUrl } from "./practice-sources.mjs";
+
+const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
+const reportPath = path.join(root, "data", "discovery-report.json");
+const seenPath = path.join(root, "data", "practice-seen.json");
+
+const report = JSON.parse(fs.readFileSync(reportPath, "utf8"));
+if (!report.practice || !Array.isArray(report.practice.hits)) {
+  console.error("discovery report has no practice.hits — re-run npm run discover");
+  process.exit(1);
+}
+
+const seenRaw = fs.existsSync(seenPath) ? JSON.parse(fs.readFileSync(seenPath, "utf8")) : { urls: [] };
+const seen = new Set(loadSeenUrls(seenRaw).map(normalizeUrl));
+const missing = report.practice.hits.filter((hit) => !seen.has(normalizeUrl(hit.url)));
+
+if (missing.length) {
+  console.error(`practice-seen.json is missing ${missing.length} URL(s) from this discovery report:`);
+  for (const hit of missing) console.error(`- ${hit.url}`);
+  process.exit(1);
+}
+
+console.log(`practice-seen: ${report.practice.hits.length} discovery URL(s) recorded`);
