{
  "name": "cyber-portfolio-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Personal website, portfolio bank, and automated news radar with a cyber/space aesthetic.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "news:fetch": "tsx src/scripts/fetch-news.ts --once",
    "news:watch": "tsx src/scripts/fetch-news.ts",
    "powerbi:sync": "node scripts/power-bi/sync.mjs",
    "stories:sync": "node scripts/sync-storytelling.mjs",
    "live:fetch": "tsx src/scripts/fetch-live-power.ts",
    "live:fetch-eu": "tsx --conditions=react-server src/scripts/fetch-live-eu-spot.ts",
    "live:fill-eu": "tsx --conditions=react-server src/scripts/fetch-live-eu-spot.ts --fill",
    "live:fetch-eu-pulse": "tsx --conditions=react-server src/scripts/fetch-live-eu-pulse.ts",
    "live:fill-eu-pulse": "tsx --conditions=react-server src/scripts/fetch-live-eu-pulse.ts --fill",
    "live:fetch-housing": "tsx src/scripts/fetch-live-housing.ts",
    "live:build-eu-map": "node scripts/live/build-eu-zone-paths.mjs",
    "live:build-housing-map": "node scripts/live/build-housing-postal-paths.mjs",
    "weekly:draft": "tsx src/scripts/weekly-write.ts --once",
    "weekly:notify": "tsx src/scripts/weekly-write.ts --once --notify --force",
    "weekly:notify-draft": "tsx src/scripts/weekly-write.ts --notify-only",
    "newsletter:draft": "tsx src/scripts/newsletter.ts",
    "newsletter:notify": "tsx src/scripts/newsletter.ts --notify --force",
    "arch:validate-all": "node scripts/architecture/validate-all.mjs",
    "arch:sync-all": "node scripts/architecture/sync-all.mjs",
    "test:vercel-ignore": "node scripts/vercel-ignore.mjs --test",
    "ship:check": "node scripts/check-deploy-author.mjs && node scripts/vercel-ignore.mjs --test && npm run build",
    "live:fetch-mix": "tsx src/scripts/fetch-live-power-mix.ts",
    "live:fetch-economy": "tsx src/scripts/fetch-live-economy.ts"
  },
  "dependencies": {
    "@tsparticles/engine": "^4.2.0",
    "@tsparticles/react": "^4.2.0",
    "@tsparticles/slim": "^4.2.0",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.21.0",
    "mermaid": "^11.16.0",
    "next": "^16.2.9",
    "next-mdx-remote": "^6.0.0",
    "node-cron": "^4.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-scrollama": "^2.4.2",
    "rss-parser": "^3.13.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
