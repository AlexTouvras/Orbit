# Copy to .env.local for local dev, or to .env.production on the server.
# Generate strong random values for the secrets below, e.g.:
#   openssl rand -hex 32

# --- Studio (private content editor) ---------------------------------------
# Password for logging into the private Studio at /studio. REQUIRED in prod.
# Pick something long; it is compared in constant time.
STUDIO_PASSWORD=change-me-to-a-strong-password

# Secret used to sign Studio session cookies (HMAC). REQUIRED in prod.
# If unset, the app falls back to CRON_SECRET, then to an insecure dev default.
#   openssl rand -hex 32
STUDIO_SESSION_SECRET=change-me-to-a-long-random-string

# --- Scheduled news refresh -------------------------------------------------
# Secret used to authorize the news refresh endpoint (/api/cron/news).
# Sent as a Bearer token by the systemd news timer (or pass ?secret=... locally).
# If unset, the endpoint is unauthenticated (only OK for local dev).
#   openssl rand -hex 32
CRON_SECRET=change-me-to-a-long-random-string

# --- Site ------------------------------------------------------------------
# Public site URL (used for absolute OG/canonical URLs).
# In production set this to your real HTTPS URL, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form (pick one) -------------------------------------------------
# Option A — Web3Forms (recommended on Vercel): free at https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# Option B — Resend: https://resend.com (API key must start with re_)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- GitHub (Studio on Vercel + optional portfolio rate limits) --------------
# Fine-grained PAT with Contents read/write on this repo. Required on Vercel so
# Studio can commit data/profile.json and data/published-projects.json.
GITHUB_TOKEN=
GITHUB_REPO=AlexTouvras/Orbit

# Optional: raises GitHub API rate limits for the Portfolio repo showcase.
# GITHUB_TOKEN above also covers this if set.

# --- Weekly Write (Slack approve → publish) --------------------------------
# Prefer the #orbit Incoming Webhook. Free plan OK.
# Setup: https://api.slack.com/apps → Incoming Webhooks → add to #orbit.
SLACK_ORBIT_WEBHOOK_URL=
# Legacy fallback (old #career-ops webhook) if SLACK_ORBIT_WEBHOOK_URL is unset.
# SLACK_WEBHOOK_URL=

# Optional: attach the full essay as a .md file in Slack (Incoming Webhooks cannot).
# On the same Slack app: OAuth & Permissions → Bot Token Scopes → files:write
# Install app → copy Bot User OAuth Token (xoxb-…). Invite the bot to #orbit.
# Channel ID: Slack → #orbit details → copy Channel ID (starts with C).
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C...

# Optional: separate HMAC secret for Approve/Skip links (falls back to CRON_SECRET).
#   openssl rand -hex 32
WEEKLY_WRITE_SECRET=

# Primary writer: Cursor Cloud Automation / IDE (skips Gemini + template scaffold).
# WEEKLY_WRITE_USE_CLOUD_AUTOMATION=1
#
# Optional legacy cloud drafts. Order: Ollama (local) → Gemini → OpenAI → template.
# Ollama — free/local; default http://127.0.0.1:11434 model llama3.2
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_WEEKLY_MODEL=llama3.2
# WEEKLY_WRITE_DISABLE_OLLAMA=1
#
# Gemini free tier: https://aistudio.google.com/apikey (CareerOps uses this too)
# GEMINI_API_KEY=
# GEMINI_WEEKLY_MODEL=gemini-2.0-flash
#
# OpenAI (paid) — not required
# OPENAI_API_KEY=
# OPENAI_WEEKLY_MODEL=gpt-4o-mini
